# Database (Supabase — set DATABASE_URL, or use individual vars for local Docker)
DATABASE_URL=

# Local Docker fallback (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalflow
DB_USER=signalflow
DB_PASSWORD=signalflow_password

# Redis (Upstash for production, or local Docker)
# Set UPSTASH vars for production; REDIS_URL is used for local Docker
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379

# Groq AI (optional — triage is skipped when not set)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
