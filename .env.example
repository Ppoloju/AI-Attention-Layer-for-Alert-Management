# ─── Database ────────────────────────────────────────────────────────────────
# Option A (production / hosted): single Supabase connection string.
# When DATABASE_URL is set it takes precedence over the individual DB_* vars.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Option B (local Docker): used when DATABASE_URL is not set.
# These match the credentials in docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalflow
DB_USER=signalflow
DB_PASSWORD=signalflow_password
# Host port published by docker-compose for Postgres (bump if 5432 is already taken; keep DB_PORT in sync)
POSTGRES_PORT=5432

# Optional Supabase connection parts (used to build the URL when DATABASE_URL is unset)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Force a specific database target (optional):
# USE_LOCAL_DATABASE=true
# USE_SUPABASE_DATABASE=true

# ─── Redis queue ─────────────────────────────────────────────────────────────
# Upstash (production): set both vars — they take precedence over REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local Docker Redis fallback
REDIS_URL=redis://localhost:6379

# ─── Groq AI (optional) ──────────────────────────────────────────────────────
# Triage is skipped gracefully when GROQ_API_KEY is not set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── Supabase auth (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
