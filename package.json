{
  "name": "signalflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker-compose up -d postgres redis",
    "db:down": "docker-compose down",
    "dev": "npm run db:up && concurrently \"npm run frontend:dev\" \"npm run backend:worker\"",
    "dev:full": "npm run dev",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:worker": "cd backend && npm run worker",
    "test": "cd backend && npm test"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/redis": "^1.38.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
